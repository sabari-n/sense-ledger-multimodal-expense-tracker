# ─────────────────────────────────────────────────────────────
# Voice Expense Tracker — Environment Variables Template
# Copy this file to .env and fill in your real values.
# This file IS committed; .env is NOT.
# ─────────────────────────────────────────────────────────────

# ── API Server ────────────────────────────────────────────────
PORT=9088

# ── PostgreSQL Database ───────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=6033
DB_USER=expense_user
DB_PASSWORD=expense_password
DB_NAME=expense_db



# ── Ollama Local LLM ──────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# ── Python Microservices ──────────────────────────────────────
WHISPER_URL=http://127.0.0.1:5000/transcribe
OCR_URL=http://127.0.0.1:5001/ocr

# ── Apache Kafka Broker ───────────────────────────────────────
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC_AUDIO_INGESTION=audio-ingestion-events
KAFKA_TOPIC_IMAGE_INGESTION=image-ingestion-events
KAFKA_TOPIC_TEXT_EXTRACTED=text-extracted-events
KAFKA_TOPIC_EXPENSE_STRUCTURED=expense-structured-events

# ── Application Defaults ──────────────────────────────────────
DEFAULT_ACCOUNT=Union Bank
DEFAULT_EXPENSE_CATEGORY=Other
DEFAULT_INCOME_CATEGORY=Other Income
CURRENCY_SYMBOL=₹

# ── Telegram Bot Token ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

