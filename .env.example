# ─────────────────────────────────────────────────────────────
# Voice Expense Tracker — Environment Variables Template
# Copy this file to .env and fill in your real values.
# This file IS committed; .env is NOT.
# ─────────────────────────────────────────────────────────────

# ── API Server ────────────────────────────────────────────────
PORT=9088

# ── PostgreSQL Database ───────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=6033
DB_USER=expense_user
DB_PASSWORD=expense_password
DB_NAME=expense_db



# ── AI Compute Device (Docker Compose) ────────────────────────
# cpu    = all models on CPU in Docker (default)
# metal  = Apple Silicon: Ollama runs natively on the Mac, Whisper and OCR stay on CPU
# nvidia = Ollama, Whisper and OCR on an NVIDIA GPU (needs NVIDIA Container Toolkit)
# After changing this, run: docker compose up -d --build
AI_DEVICE=cpu
# With AI_DEVICE=nvidia, set either of these to cpu to keep that service off the GPU
# WHISPER_DEVICE=cuda
# OCR_DEVICE=cuda

# ── Ollama Local LLM ──────────────────────────────────────────
# OLLAMA_HOST applies when the API runs outside Docker; AI_DEVICE sets it inside Docker
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# ── Python Microservices ──────────────────────────────────────
WHISPER_URL=http://127.0.0.1:5000/transcribe
# Host port for Whisper in Docker. macOS AirPlay Receiver often holds 5000, so use 5050 there
WHISPER_HOST_PORT=5050
OCR_URL=http://127.0.0.1:5001/ocr

# ── Apache Kafka Broker ───────────────────────────────────────
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC_AUDIO_INGESTION=audio-ingestion-events
KAFKA_TOPIC_IMAGE_INGESTION=image-ingestion-events
KAFKA_TOPIC_TEXT_EXTRACTED=text-extracted-events
KAFKA_TOPIC_EXPENSE_STRUCTURED=expense-structured-events

# ── Application Defaults ──────────────────────────────────────
DEFAULT_ACCOUNT=Union Bank
DEFAULT_EXPENSE_CATEGORY=Other
DEFAULT_INCOME_CATEGORY=Other Income
CURRENCY_SYMBOL=₹

# ── Telegram Bot Token ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

