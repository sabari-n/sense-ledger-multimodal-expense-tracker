          },
          "expr": "(sum(container_memory_working_set_bytes{id=~\"/docker/.+\"}) by (name, id, image) / sum(container_spec_memory_limit_bytes{id=~\"/docker/.+\"} > 0) by (name, id, image)) * 100",
