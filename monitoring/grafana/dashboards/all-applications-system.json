          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(container_memory_working_set_bytes{id=~\"/docker/.+\"}) by (name, id, image)",
          "legendFormat": "{{name}} {{image}} ({{id}})",
          "refId": "A"
        }
      ],
      "title": "🧠 RAM Usage (Memory Working Set) per Container",
      "type": "timeseries"
